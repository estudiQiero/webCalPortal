---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<form class="card" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form">
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="lang" value={lang} />
  <p style="display:none;">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>

  <label>
    {t.contact.name}
    <input type="text" name="name" required />
  </label>
  <label>
    {t.contact.email}
    <input type="email" name="email" required />
  </label>
  <label>
    {t.contact.phone}
    <input type="tel" name="phone" />
  </label>
  <label>
    {t.contact.message}
    <textarea name="message" required></textarea>
  </label>

  <button type="submit" class="btn btn-solid">{t.contact.send}</button>
  <p class="form-status" id="contact-status"></p>
</form>

<script define:vars={{ successMsg: t.contact.success }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');

  function encode(data) {
    return Object.keys(data)
      .map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(data[key]))
      .join('&');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: encode(data),
    })
      .then(() => {
        status.textContent = successMsg;
        status.className = 'form-status ok';
        form.reset();
      })
      .catch(() => {
        status.textContent = 'Error';
        status.className = 'form-status error';
      });
  });
</script>
