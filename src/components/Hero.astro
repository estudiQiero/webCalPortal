---
import { getLangFromUrl, useTranslations, getLocalizedPath, languages } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;
---

<section class="hero">
  <div class="hero-trees"><img src="/img/arbresFrontals.webp" alt="" /></div>

  <div class="hero-inner">
    <h1 class="text-shadow" set:html={t.hero.titleHtml} />
    <img class="logo-mark" src="/img/logotipo-cal-portal.svg" alt="Cal Portal" />
    <p class="hero-sub text-shadow" set:html={t.hero.subtitleHtml} />

    <div class="chip-panel" id="panel-lang">
      <h3>{t.hero.langPanelTitle}</h3>
      <ul class="lang-list">
        {Object.entries(languages).map(([code, label]) => (
          <li>
            <a
              href={getLocalizedPath(path, code as keyof typeof languages)}
              aria-current={code === lang ? 'true' : undefined}
            >
              <span class="lang-code">{code}</span>{label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="chip-panel" id="panel-about">
      <h3>{t.aboutModal.title}</h3>
      <p>{t.aboutModal.text}</p>
      <div class="owners-row">
        <figure>
          <img src="/img/calportalJoss.svg" alt={t.aboutModal.names[0]} />
          <figcaption>{t.aboutModal.names[0]}</figcaption>
        </figure>
        <figure>
          <img src="/img/calportalMiq.svg" alt={t.aboutModal.names[1]} />
          <figcaption>{t.aboutModal.names[1]}</figcaption>
        </figure>
      </div>
    </div>

    <div class="chip-panel" id="panel-location">
      <h3>{t.location.title}</h3>
      <p>{t.location.text}</p>
      <div class="location-map">
        <iframe
          title="Cal Portal — Torrefeta i Florejacs"
          src="https://www.openstreetmap.org/export/embed.html?bbox=1.1372%2C41.6989%2C1.1672%2C41.7189&layer=mapnik&marker=41.7089%2C1.1522"
          loading="lazy"
        ></iframe>
      </div>
      <a class="location-link" href="https://www.google.com/maps?q=41.7089,1.1522" target="_blank" rel="noopener">
        {t.location.openInMaps} →
      </a>
    </div>

    <div class="hero-cta">
      <a class="btn btn-solid" href={`/${lang}/reserves/`}>{t.hero.ctaBook}</a>
      <a class="btn" href={`/${lang}/habitacions/`}>{t.hero.ctaRooms}</a>
    </div>
  </div>

  <picture class="hero-house">
    <source srcset="/img/contornA.svg" media="(max-width: 549px)" />
    <img src="/img/casaBase.svg" alt="Cal Portal" />
  </picture>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLElement>('.word-trigger');
  const panels = document.querySelectorAll<HTMLElement>('.chip-panel');

  function closeAllPanels() {
    panels.forEach((p) => p.classList.remove('is-open'));
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const panel = document.getElementById(`panel-${trigger.dataset.panel}`);
      const isOpen = panel?.classList.contains('is-open');
      closeAllPanels();
      if (!isOpen) panel?.classList.add('is-open');
    });
  });

  // Clicking anywhere outside an open panel (and outside the word that
  // triggered it) closes whatever is open.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.chip-panel') || target.closest('.word-trigger')) return;
    closeAllPanels();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPanels();
  });
</script>
