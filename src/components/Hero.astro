---
import { getLangFromUrl, useTranslations, getLocalizedPath, languages } from '../i18n';
import ca from '../i18n/ca';
import es from '../i18n/es';
import fr from '../i18n/fr';
import en from '../i18n/en';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

// Each language's own word for "welcome", shown next to its code in the
// language-switcher dropdown (matches the old site: CAT · Benvinguts,
// ESP · Bienvenidos, etc.) regardless of the page's current language.
const greetings: Record<string, string> = {
  ca: ca.hero.welcome,
  es: es.hero.welcome,
  fr: fr.hero.welcome,
  en: en.hero.welcome,
};
const langAbbrev: Record<string, string> = { ca: 'CAT', es: 'ESP', fr: 'FRA', en: 'ENG' };
---

<section class="hero">
  <div class="hero-trees"><img src="/img/arbresFrontals.webp" alt="" /></div>

  <div class="hero-inner">
    <h1 class="text-shadow" set:html={t.hero.titleHtml} />
    <img class="logo-mark" src="/img/logotipo-cal-portal.svg" alt="Cal Portal" />
    <p class="hero-sub text-shadow" set:html={t.hero.subtitleHtml} />

    <div class="chip-panel chip-panel--float" id="panel-lang">
      <h3 class="visually-hidden">{t.hero.langPanelTitle}</h3>
      <ul class="lang-list">
        {Object.entries(languages).map(([code]) => (
          <li>
            <a
              href={getLocalizedPath(path, code as keyof typeof languages)}
              aria-current={code === lang ? 'true' : undefined}
            >
              <span class="lang-code">{langAbbrev[code]}</span>
              <span class="lang-greeting">{greetings[code]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="chip-panel" id="panel-about">
      <h3>{t.aboutModal.title}</h3>
      <p>{t.aboutModal.text}</p>
      <div class="owners-row">
        <figure>
          <img src="/img/calportalJoss.svg" alt={t.aboutModal.names[0]} />
          <figcaption>{t.aboutModal.names[0]}</figcaption>
        </figure>
        <figure>
          <img src="/img/calportalMiq.svg" alt={t.aboutModal.names[1]} />
          <figcaption>{t.aboutModal.names[1]}</figcaption>
        </figure>
      </div>
    </div>

    <div class="chip-panel" id="panel-location">
      <h3>{t.location.title}</h3>
      <p>{t.location.text}</p>
      <div class="location-map">
        <iframe
          title="Cal Portal — Torrefeta i Florejacs"
          src="https://www.openstreetmap.org/export/embed.html?bbox=1.1372%2C41.6989%2C1.1672%2C41.7189&layer=mapnik&marker=41.7089%2C1.1522"
          loading="lazy"
        ></iframe>
      </div>
      <a class="location-link" href="https://www.google.com/maps?q=41.7089,1.1522" target="_blank" rel="noopener">
        {t.location.openInMaps} →
      </a>
    </div>

    <div class="hero-cta">
      <a class="btn btn-solid" href={`/${lang}/reserves/`}>{t.hero.ctaBook}</a>
      <a class="btn" href={`/${lang}/habitacions/`}>{t.hero.ctaRooms}</a>
    </div>
  </div>

  <picture class="hero-house">
    <source srcset="/img/contornA.svg" media="(max-width: 549px)" />
    <img src="/img/casaBase.svg" alt="Cal Portal" />
  </picture>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLElement>('.word-trigger');
  const panels = document.querySelectorAll<HTMLElement>('.chip-panel');
  let openFloatHandlers: { reposition: () => void } | null = null;

  function closeAllPanels() {
    panels.forEach((p) => p.classList.remove('is-open'));
    if (openFloatHandlers) {
      window.removeEventListener('resize', openFloatHandlers.reposition);
      window.removeEventListener('scroll', openFloatHandlers.reposition, true);
      openFloatHandlers = null;
    }
  }

  // Floating panels (e.g. the language switcher) are taken out of the
  // normal document flow so opening them never pushes or re-centers the
  // hero title, and they have no background fill — they read as text
  // and lines floating over the hero. Their position is computed from
  // the trigger word's own on-screen box: they open right above it,
  // like the original site. The hero has plenty of clear room for that
  // on desktop, but on narrow screens the word sits right under the
  // header with no clear space above or below it to show a fill-less
  // panel without it blending into other text — so there we drop it
  // into the open hero background under the whole title block instead.
  function positionFloatingPanel(trigger: HTMLElement, panel: HTMLElement) {
    const parent = (panel.offsetParent as HTMLElement) || document.body;

    // Measure the panel's natural size without it being visible/affecting layout.
    panel.style.visibility = 'hidden';
    panel.classList.add('is-open');
    const panelRect = panel.getBoundingClientRect();
    panel.classList.remove('is-open');
    panel.style.visibility = '';

    const parentRect = parent.getBoundingClientRect();
    const triggerRect = trigger.getBoundingClientRect();
    const gap = 12;

    // Some panels mark, via --panel-anchor-offset, where their own
    // dividing line sits (e.g. the language list's vertical rule). When
    // present, we line that mark up with the start of the trigger word
    // instead of just centering the whole panel under it.
    const anchorEl = panel.querySelector<HTMLElement>('.lang-list') || panel;
    const anchorOffsetRaw = getComputedStyle(anchorEl).getPropertyValue('--panel-anchor-offset');
    const anchorOffset = anchorOffsetRaw ? parseFloat(anchorOffsetRaw) : NaN;

    // All of this is done in viewport coordinates first (so it can be
    // compared against elements outside the hero, like the header),
    // then converted to hero-relative coordinates at the end.
    let leftAboveVp = Number.isFinite(anchorOffset)
      ? triggerRect.left - anchorOffset
      : triggerRect.left + triggerRect.width / 2 - panelRect.width / 2;
    leftAboveVp = Math.max(8, Math.min(leftAboveVp, window.innerWidth - panelRect.width - 8));

    const aboveTopVp = triggerRect.top - panelRect.height - gap;

    // The panel has no fill, so a little proximity to the header is
    // harmless — what actually matters is whether it has room to exist
    // above the word at all without running off the top of the screen.
    const fitsAbove = aboveTopVp >= 8;

    let leftVp: number;
    let topVp: number;
    if (fitsAbove) {
      leftVp = leftAboveVp;
      topVp = aboveTopVp;
    } else {
      const safeZone = document.querySelector('.hero-cta') || trigger;
      const safeRect = safeZone.getBoundingClientRect();
      topVp = safeRect.bottom + gap;
      leftVp = parentRect.left + parentRect.width / 2 - panelRect.width / 2;
      leftVp = Math.max(8, Math.min(leftVp, window.innerWidth - panelRect.width - 8));
    }

    panel.style.left = `${leftVp - parentRect.left}px`;
    panel.style.top = `${topVp - parentRect.top}px`;
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const panel = document.getElementById(`panel-${trigger.dataset.panel}`);
      if (!panel) return;
      const isOpen = panel.classList.contains('is-open');
      closeAllPanels();
      if (isOpen) return;

      if (panel.classList.contains('chip-panel--float')) {
        positionFloatingPanel(trigger, panel);
        const reposition = () => positionFloatingPanel(trigger, panel);
        openFloatHandlers = { reposition };
        window.addEventListener('resize', reposition);
        window.addEventListener('scroll', reposition, true);
      }
      panel.classList.add('is-open');
    });
  });

  // Clicking anywhere outside an open panel (and outside the word that
  // triggered it) closes whatever is open.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.chip-panel') || target.closest('.word-trigger')) return;
    closeAllPanels();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPanels();
  });
</script>
