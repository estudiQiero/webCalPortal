---
import { getLangFromUrl, useTranslations, getLocalizedPath, languages } from '../i18n';
import ca from '../i18n/ca';
import es from '../i18n/es';
import fr from '../i18n/fr';
import en from '../i18n/en';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

// Each language's own word for "welcome", shown next to its code in the
// language-switcher dropdown (matches the old site: CAT · Benvinguts,
// ESP · Bienvenidos, etc.) regardless of the page's current language.
const greetings: Record<string, string> = {
  ca: ca.hero.welcome,
  es: es.hero.welcome,
  fr: fr.hero.welcome,
  en: en.hero.welcome,
};
const langAbbrev: Record<string, string> = { ca: 'CAT', es: 'ESP', fr: 'FRA', en: 'ENG' };
---

<section class="hero">
  <div class="hero-trees"><img src="/img/arbresFrontals.webp" alt="" /></div>

  <div class="hero-inner">
    <h1 class="text-shadow" set:html={t.hero.titleHtml} />
    <img class="logo-mark" src="/img/logotipo-cal-portal.svg" alt="Cal Portal" />
    <p class="hero-sub text-shadow" set:html={t.hero.subtitleHtml} />

    <div class="chip-panel chip-panel--float" id="panel-lang">
      <h3 class="visually-hidden">{t.hero.langPanelTitle}</h3>
      <ul class="lang-list">
        {Object.entries(languages).map(([code]) => (
          <li>
            <a
              href={getLocalizedPath(path, code as keyof typeof languages)}
              aria-current={code === lang ? 'true' : undefined}
            >
              <span class="lang-code">{langAbbrev[code]}</span>
              <span class="lang-greeting">{greetings[code]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="chip-panel chip-panel--float" id="panel-about">
      <h3 class="visually-hidden">{t.aboutModal.title}</h3>
      <p class="visually-hidden">{t.aboutModal.text}</p>
      <div class="owners-cluster">
        <figure class="owner owner--a">
          <figcaption>{t.aboutModal.names[0]}</figcaption>
          <img src="/img/calportalJoss.svg" alt="" />
        </figure>
        <figure class="owner owner--b">
          <img src="/img/calportalMiq.svg" alt="" />
          <figcaption>{t.aboutModal.names[1]}</figcaption>
        </figure>
      </div>
    </div>

    <div class="chip-panel chip-panel--anchored" id="panel-location">
      <h3>{t.location.title}</h3>
      <p>{t.location.text}</p>
      <dl class="location-stats">
        {t.location.stats.map((stat) => (
          <div class="stat-row">
            <dt>{stat.label}</dt>
            <dd>
              {'href' in stat && stat.href ? (
                <a href={stat.href} target="_blank" rel="noopener">{stat.value}</a>
              ) : (
                stat.value
              )}
            </dd>
          </div>
        ))}
      </dl>
      <a class="location-link" href="https://www.google.com/maps?q=41.754077,1.274676" target="_blank" rel="noopener">
        {t.location.openInMaps} →
      </a>
    </div>

  </div>

  <picture class="hero-house">
    <source srcset="/img/contornA.svg" media="(max-width: 549px)" />
    <img src="/img/casaBase.svg" alt="Cal Portal" />
  </picture>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLElement>('.word-trigger');
  const panels = document.querySelectorAll<HTMLElement>('.chip-panel');
  let openFloatHandlers: { reposition: () => void } | null = null;

  function closeAllPanels() {
    panels.forEach((p) => p.classList.remove('is-open'));
    if (openFloatHandlers) {
      window.removeEventListener('resize', openFloatHandlers.reposition);
      window.removeEventListener('scroll', openFloatHandlers.reposition, true);
      openFloatHandlers = null;
    }
  }

  // Floating panels (e.g. the language switcher) are taken out of the
  // normal document flow so opening them never pushes or re-centers the
  // hero title, and they have no background fill — they read as text
  // and lines floating over the hero. They always open right above
  // their trigger word, like the original site: never overlapping the
  // word itself, and clamped so they never run off the top of the
  // screen on short viewports either.
  function positionFloatingPanel(trigger: HTMLElement, panel: HTMLElement) {
    // Not panel.offsetParent: the panel is still `display: none` at this
    // point (is-open is added below), and offsetParent of a display:none
    // element is null — which silently fell back to <body> here, throwing
    // every coordinate off by however far .hero-inner sits from the page
    // top. The panel's actual DOM parent (.hero-inner, position: relative)
    // is the real positioning context regardless of its display state.
    const parent = (panel.parentElement as HTMLElement) || document.body;

    // Measure the panel's natural size without it being visible/affecting layout.
    panel.style.visibility = 'hidden';
    panel.classList.add('is-open');
    const panelRect = panel.getBoundingClientRect();
    panel.classList.remove('is-open');
    panel.style.visibility = '';

    const parentRect = parent.getBoundingClientRect();
    const triggerRect = trigger.getBoundingClientRect();
    const gap = 14;

    // Always centered on the trigger word itself (in viewport coordinates
    // first, then converted to hero-relative coordinates below), clamped
    // so it never runs off either edge of the viewport.
    let leftVp = triggerRect.left + triggerRect.width / 2 - panelRect.width / 2;
    leftVp = Math.max(8, Math.min(leftVp, window.innerWidth - panelRect.width - 8));

    // Always above the word, by at least `gap`. On an unusually short
    // viewport this can push the top of the panel above the visible
    // screen — better that than ever covering the word it belongs to.
    const topVp = triggerRect.top - panelRect.height - gap;

    panel.style.left = `${leftVp - parentRect.left}px`;
    panel.style.top = `${topVp - parentRect.top}px`;
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const panel = document.getElementById(`panel-${trigger.dataset.panel}`);
      if (!panel) return;
      const isOpen = panel.classList.contains('is-open');
      closeAllPanels();
      if (isOpen) return;

      if (panel.classList.contains('chip-panel--float') || panel.classList.contains('chip-panel--anchored')) {
        positionFloatingPanel(trigger, panel);
        const reposition = () => positionFloatingPanel(trigger, panel);
        openFloatHandlers = { reposition };
        window.addEventListener('resize', reposition);
        window.addEventListener('scroll', reposition, true);

        // The custom serif font can still be swapping in for the fallback
        // when this first position is computed (font-display: swap), which
        // reflows the title afterwards and silently invalidates it. Redo it
        // once the real font has actually finished loading.
        if (document.fonts && document.fonts.status !== 'loaded') {
          document.fonts.ready.then(() => {
            if (panel.classList.contains('is-open')) reposition();
          });
        }
      }
      panel.classList.add('is-open');
    });
  });

  // Clicking anywhere outside an open panel (and outside the word that
  // triggered it) closes whatever is open.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.chip-panel') || target.closest('.word-trigger')) return;
    closeAllPanels();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPanels();
  });
</script>
